ENV=dev
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ANTHROPIC_API_KEY=sk-ant-api03-FAKE-KEY-HERE
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MODEL=claude-sonnet-4-6
ALLOWED_CHAT_ID=-1001234567890
# Opcional: solo si el grupo usa forum/topics y quieres restringir a un hilo.
# Dejar vacio para deteccion dinamica (funciona con y sin topics).
ALLOWED_THREAD_ID=
ADMIN_USER_ID=123456789
# Admins que reciben /reportar (IDs separados por coma). Si vacío, usa ADMIN_USER_ID.
REPORT_ADMIN_IDS_RAW=123456789,987654321
BOT_VERSION=1.254
QUEUE_TIMEOUT=45.0
FEEDBACK_EXPIRY_DAYS=7
USE_BLOCKQUOTE=true
MAX_CONCURRENT_API=3
